cmake_minimum_required(VERSION 3.24)
if(NOT IS_ABSOLUTE "${BINARY_DIR}" OR NOT IS_ABSOLUTE "${SOURCE_DIR}"
        OR NOT EXISTS "${BINARY_DIR}/CMakeCache.txt")
    message(FATAL_ERROR "Supply absolute BINARY_DIR and SOURCE_DIR after a Release preset build")
endif()
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(platform linux-x86_64)
    file(STRINGS "${BINARY_DIR}/CMakeCache.txt" configuration REGEX "^CMAKE_BUILD_TYPE:[^=]+=Release$")
    if(configuration STREQUAL "")
        message(FATAL_ERROR "Linux preview packages require a Release build tree")
    endif()
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    set(platform windows-x86_64)
    if(NOT CONFIG STREQUAL "Release")
        message(FATAL_ERROR "Windows preview packages require explicit CONFIG=Release")
    endif()
else()
    message(FATAL_ERROR "Use PackageMacPreview.cmake for macOS")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/PreviewPackageCommon.cmake")
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot identify the source commit")
endif()
set(stage "${BINARY_DIR}/preview-package-${commit}/UndertowPreview")
file(MAKE_DIRECTORY "${stage}")
if(NOT EXISTS "${BINARY_DIR}/bin/UndertowPreview.vst3")
    message(FATAL_ERROR "Missing Undertow Preview VST3 bundle")
endif()
file(COPY "${BINARY_DIR}/bin/UndertowPreview.vst3" DESTINATION "${stage}")
preview_package_metadata("${stage}" "${platform}")
set(archive "${BINARY_DIR}/UndertowPreview-${platform}.zip")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip UndertowPreview
    WORKING_DIRECTORY "${BINARY_DIR}/preview-package-${commit}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Preview ZIP creation failed")
endif()
file(SHA256 "${archive}" digest)
file(WRITE "${archive}.sha256" "${digest}  UndertowPreview-${platform}.zip\n")
